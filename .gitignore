.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
google-services.json

# Version control
vcs.xml

# Lint
lint/

# Android Profiling
*.hprof

# Crashlytics
fabric.properties

# macOS
.DS_Store

# gitleaks local config (contains absolute paths)
.gitleaks.toml
